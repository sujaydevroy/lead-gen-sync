# Copy to backend/.env (never commit .env). See BACKEND_PLAN.md §7.

ENVIRONMENT=development

# PostgreSQL connection. URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
# Supabase: append ?sslmode=require. With the transaction pooler (port 6543) also set
# DB_DISABLE_PREPARED_STATEMENTS=true.
DATABASE_URL=postgresql://dcp_app:change-me@localhost:5432/dealer_portal
DB_DISABLE_PREPARED_STATEMENTS=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS_REMEMBER=30
REFRESH_TOKEN_HOURS=12
# true in production (HTTPS). false only for local http://localhost development.
COOKIE_SECURE=false

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=10

FRONTEND_ORIGIN=http://localhost:3000
