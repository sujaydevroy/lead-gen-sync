# Copy to .env (same folder) and fill in what you use. .env is not committed.

# Your e-mail, shown to websites in the crawler's User-Agent (recommended)
CRAWLER_CONTACT_EMAIL=

# Free key from data.gov.in (sign in -> My Account -> API key); only for sources with datagov_resource
DATA_GOV_IN_API_KEY=

# Enables AI extraction (pages without tables, dealer websites). Leave empty to run without AI.
ANTHROPIC_API_KEY=

# Optional
# CRAWLER_LLM_MODEL=claude-haiku-5-5
# CRAWLER_LLM_RETRY_MODEL=claude-sonnet-5-5
# CRAWLER_LLM_MAX_CALLS=200
# CRAWLER_DELAY_SECONDS=1.0
