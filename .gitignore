# Repo-wide rules only. App-specific rules: frontend/.gitignore and backend/.gitignore.

# Secrets anywhere in the repo: only the *.example files are tracked
# (e.g. backend/.env.bak written by setup_env.py must never be committed).
.env
.env.*
!.env.example

# Python caches (database/*.py scripts as well as the backend)
__pycache__/

# OS / editor files
.DS_Store
Thumbs.db

# Database dumps (full Supabase backups hold secrets, sessions and password hashes): keep them local only
database/backup/
*.backup
*.dump
